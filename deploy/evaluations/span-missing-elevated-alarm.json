{
  "AlarmName": "agentcore-hub-eval-span-missing-elevated",
  "AlarmDescription": "Ticket severity (not a pager): more than 5% of eval sessions over 6-hour windows have no invoke_agent span — a slow telemetry regression well below the 50% agentcore-hub-eval-span-missing-ratio pager. File a ticket against runtime telemetry (Strands/ADOT tracer wiring), not agent quality. Fires on 3 of 4 six-hour datapoints. INSUFFICIENT_DATA when no eval sessions arrive.",
  "ActionsEnabled": true,
  "EvaluationPeriods": 4,
  "DatapointsToAlarm": 3,
  "Threshold": 0.05,
  "ComparisonOperator": "GreaterThanThreshold",
  "TreatMissingData": "missing",
  "Metrics": [
    {
      "Id": "missing",
      "MetricStat": {
        "Metric": {
          "Namespace": "AgentCoreHub/Evaluations",
          "MetricName": "EvalSessionsSpanMissing"
        },
        "Period": 21600,
        "Stat": "Sum"
      },
      "ReturnData": false
    },
    {
      "Id": "total",
      "MetricStat": {
        "Metric": {
          "Namespace": "AgentCoreHub/Evaluations",
          "MetricName": "EvalSessionsTotal"
        },
        "Period": 21600,
        "Stat": "Sum"
      },
      "ReturnData": false
    },
    {
      "Id": "ratio",
      "Expression": "missing / total",
      "Label": "span_missing ratio (fleet, 6h)",
      "ReturnData": true
    }
  ]
}
