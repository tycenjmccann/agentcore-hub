{
  "AlarmName": "agentcore-hub-eval-span-missing-ratio",
  "AlarmDescription": "More than 50% of eval sessions have no invoke_agent span (all evaluator scores null with no error.type). Fires on 3 of 4 hourly datapoints. INSUFFICIENT_DATA when no eval sessions arrive.",
  "ActionsEnabled": true,
  "EvaluationPeriods": 4,
  "DatapointsToAlarm": 3,
  "Threshold": 0.5,
  "ComparisonOperator": "GreaterThanThreshold",
  "TreatMissingData": "missing",
  "Metrics": [
    {
      "Id": "missing",
      "MetricStat": {
        "Metric": {
          "Namespace": "AgentCoreHub/Evaluations",
          "MetricName": "EvalSessionsSpanMissing"
        },
        "Period": 3600,
        "Stat": "Sum"
      },
      "ReturnData": false
    },
    {
      "Id": "total",
      "MetricStat": {
        "Metric": {
          "Namespace": "AgentCoreHub/Evaluations",
          "MetricName": "EvalSessionsTotal"
        },
        "Period": 3600,
        "Stat": "Sum"
      },
      "ReturnData": false
    },
    {
      "Id": "ratio",
      "Expression": "missing / total",
      "Label": "span_missing ratio (fleet)",
      "ReturnData": true
    }
  ]
}
