{
  "_fixture": {
    "ticket": "TEAM-4760 U1",
    "purpose": "The SI recommendation ledger exists twice — lambda/workflow-analyzer/si-ledger.mjs (canonical JS, byte-copied into lambda/prd-submitter/) and deploy/workflow-manager/toolkit/si_ledger.py (the Python twin on the WM harness). Neither can import the other: different language, different zip. So they share THIS fixture instead. Both unit suites iterate every section below and assert the same expectations, which is what makes a change on either side fail on the other — the same mechanism fix-lineage.json uses for the fix-ticket predicate.",
    "readBy": [
      "lambda/workflow-analyzer/si-ledger.test.mjs (node --test)",
      "deploy/workflow-manager/toolkit/test_si_ledger.py (unittest/pytest)"
    ],
    "conventions": {
      "op": "The CANONICAL (JS) reducer name. The Python suite maps it to the snake_case twin, so a renamed export breaks one suite loudly instead of both silently.",
      "args": "Positional arguments AFTER the row, exactly as the reducer takes them. dedupeBlocked/newRow take their one object arg here.",
      "row": "The input row literal, hand-built to sit exactly on the branch the case is about. Both suites deep-copy it first and assert the reducer did NOT mutate it — purity is part of the contract, because callers reduce twice before writing once.",
      "expect": "A closed vocabulary: status, firstSeen, lastSeen, counts{occurrences,attempts,expected,verdicts}, row (full deep-equal), occurrences, attempts, expected, verdicts (array deep-equal), blocked, reason, throws (substring of the error/ValueError message). Both suites FAIL on an expect key they do not implement, so a new assertion cannot be added to one language only."
    },
    "cases": {
      "keys.valid/invalid": "isValidKey is the arbiter: >=2 dot-separated segments, each starting alphanumeric, lower-case, hyphens inside, <=120 chars. `nodot` is the one that matters most — a key with no area is not reusable, so the two-segment floor is enforced, not encouraged.",
      "keys.normalize": "What an agent actually types ('Harness.Silent-Death.Exit Without Report', '  ci .  recert loop  ') has to land on ONE row, or the ledger cannot dedupe anything. Note 'UPPER.only' appears in BOTH invalid and normalize: it is not a valid key as typed, and normalising it is how it becomes one.",
      "keys.underscore": "'harness.silent_death' normalises to itself — `_` is inside the preserved charset — and is then REJECTED, so it throws. Deliberate: a pattern key is hyphen-separated, and silently folding `_` to `-` would make a_b and a-b the same key for one caller and different keys for a human reading the table.",
      "keys.length": "The 123-char entry is the >120 cap, which exists because the key is a DynamoDB partition key printed in markdown tables and log lines.",
      "statusAfterOutcome": "The whole map, asserted entry by entry, because the cancelled/error → open edge is the one that decides whether a dead SI run's keys can ever be filed again.",
      "new-row-is-open": "The shape of a freshly minted row, pinned whole: status open, firstSeen == lastSeen == at, all four histories empty, and NO extra fields (the schema is closed).",
      "new-row-carries-source": "A backfilled row is the one case that writes the optional top-level `source`; a normal row must not carry the field at all.",
      "new-row-rejects-single-segment-key": "`<area>.<slug>` is enforced at construction. A one-segment key is not silently expanded — guessing an area would mint rows nobody can reuse.",
      "first-occurrence-on-fresh-row": "The analyzer's first write: the occurrence entry shape, and status stays open.",
      "duplicate-occurrence-bumps-lastseen-only": "Re-running ANALYZE over the same run re-files the same finding. It must not double-count (recommendation_recurrence is computed off this array) but it IS a fresh sighting, so lastSeen moves and firstSeen does not.",
      "occurrence-on-verified-row-does-not-reopen": "An occurrence on a verified row is evidence of a regression for si_verify to rule on with numbers — not an automatic reopen that would erase the verdict.",
      "occurrence-earlier-than-firstseen-backfills": "Backfilled history arrives out of order; firstSeen takes the min, not the last write.",
      "status-batched": "The staging state the synthesiser sets. No attempt is written yet (a PRD that never gets submitted must leave no phantom attempt).",
      "status-rejects-unknown": "The status enum is closed.",
      "attempt-in-run-moves-status": "markInRun's reduction: the attempt is appended and the status follows the outcome.",
      "attempt-deployed-merges-on-prdkey-and-workflow": "The same run stamped twice is ONE attempt: merge on prdKey+workflowId, keep the mergedAt an earlier stamp recorded, UNION prNumbers (a second PR must not erase the first) and sort/dedupe them numerically — including the string \"431\" a tool payload delivered.",
      "attempt-cancelled-returns-to-open-and-keeps-attempt": "A cancelled SI run fixed nothing, so the ask is owed again — but the attempt stays, or the next synthesis would re-file an identical PRD believing nothing had been tried.",
      "attempt-handoff-counts-as-landed": "The PR exists and is another team's to merge; the backlog is no longer owed the ask.",
      "attempt-rejects-unknown-outcome": "The outcome enum is closed.",
      "verdict-verified-sets-verified": "The number moved; stop re-filing it.",
      "verdict-no-effect-reopens-and-keeps-attempt": "The dropped-ask bug this feature exists to prevent: status returns to open, the failed attempt is retained as evidence.",
      "verdict-regressed-reopens": "Same transition as no-effect — a fix that made it worse still owes the backlog.",
      "verdict-insufficient-leaves-status": "Not enough observed runs yet. Judging early is worse than judging late, so nothing moves.",
      "verdict-rejects-unknown": "The verdict enum is closed.",
      "expected-defaults-and-stamps": "observeRuns defaults to 5, setAt defaults to the call's `at`, and prdKey is stamped from the call — an expectation nobody can attribute to a PRD is unverifiable.",
      "expected-replaces-same-metric-same-prd": "Re-synthesising the same PRD RESTATES its expectation (replace), while an expectation from a different prdKey is kept — that history is how 'we tried twice and neither moved it' stays visible.",
      "expected-rejects-unknown-metric": "Free-prose impact claims are what made the old loop unfalsifiable. Only METRIC_NAMES.",
      "dedupe-blocked-in-run": "A key already in flight must never be filed twice; the reason names the run so the skill can point at it.",
      "dedupe-blocked-fresh-deployed": "Shipped 3 days ago with no verdict — let si_verify judge it first.",
      "dedupe-not-blocked-fresh-deployed-with-no-effect-verdict": "The attempt shipped recently but a no-effect verdict landed AFTER it: we know it failed, so the ask is owed again immediately.",
      "dedupe-not-blocked-deployed-older-than-fresh-days": "Past freshDays with no verdict, the silence is its own signal and re-filing is correct.",
      "dedupe-not-blocked-open": "The ordinary case: an open row is always filable."
    }
  },

