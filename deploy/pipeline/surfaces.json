{
  "$comment": "Deploy-surface manifest for the pipeline's Deploy stage (deploy/pipeline/plan-surfaces.py reads it; scripts/check-deploy-surfaces.sh enforces that every lambda/* and deploy/* surface is listed here). A surface deploys when any file in pipeline-out/changed-files.txt starts with one of its `paths`. CODE ONLY: the pipeline updates Lambda code, harness prompt/model/skills and S3 toolkits \u2014 never IAM, env vars or infra. Infra scripts are `handoff` (the Deploy stage exits 2 after a good app deploy so the release manager reports them as a human step).",
  "ignore": [
    "__tests__/",
    "\\.test\\.mjs$",
    "(^|/)test_[^/]*\\.py$",
    "(^|/)tests/",
    "(^|/)(README|EVIDENCE|DECISIONS|DEPLOY)\\.md$",
    "(^|/)fixtures/",
    "\\.gitignore$",
    "package-lock\\.json$"
  ],
  "lambdas": [
    {
      "function": "agentcore-hub-cost-report",
      "dir": "lambda/cost-report",
      "files": [
        "index.mjs"
      ],
      "npm": false,
      "note": "If REPORT_VERSION changed in index.mjs, run lambda/cost-report/deploy.sh --backfill by hand (regenerates every card; --rebuild-index alone empties the fleet index)."
    },
    {
      "function": "agentcore-hub-anomaly-watcher",
      "dir": "lambda/anomaly-watcher",
      "files": [
        "index.mjs",
        "detect.mjs",
        "bands-schema.mjs",
        "bands.yaml",
        "package.json",
        "node_modules/"
      ],
      "npm": true
    },
    {
      "function": "agentcore-hub-workflow-analyzer",
      "dir": "lambda/workflow-analyzer",
      "files": [
        "index.mjs",
        "package.json",
        "node_modules/"
      ],
      "npm": true
    },
    {
      "function": "agentcore-hub-pipeline-tools",
      "dir": "lambda/agentcore-hub-pipeline-tools",
      "files": [
        "index.mjs"
      ],
      "npm": false
    },
    {
      "function": "agentcore-hub-jira",
      "dir": "lambda/agentcore-hub-jira",
      "files": [
        "index.mjs"
      ],
      "npm": false,
      "note": "Only @aws-sdk/client-s3 is declared, which the nodejs20.x runtime provides \u2014 deploy/setup-tickets-lambda.mjs ships index.mjs alone too."
    },
    {
      "function": "agentcore-hub-tickets",
      "dir": "lambda/agentcore-hub-tickets",
      "files": [
        "index.mjs"
      ],
      "npm": false,
      "optional": true,
      "note": "Absent in TICKET_PROVIDER=jira installs \u2014 skipped when the function does not exist."
    },
    {
      "function": "agentcore-hub-eval-packager",
      "dir": "lambda/eval-packager",
      "files": [
        "index.mjs",
        "lib/",
        "package.json",
        "node_modules/"
      ],
      "npm": true
    },
    {
      "function": "agentcore-hub-prd-submitter",
      "dir": "lambda/prd-submitter",
      "files": [
        "index.mjs"
      ],
      "npm": false
    },
    {
      "function": "agentcore-hub-token-aggregator",
      "dir": "lambda/token-aggregator",
      "files": [
        "index.mjs"
      ],
      "npm": false
    },
    {
      "function": "agentcore-hub-workflow-output",
      "dir": "lambda/workflow-output",
      "files": [
        "index.mjs",
        "node_modules/"
      ],
      "npm": true
    },
    {
      "function": "agentcore-hub-routines-runner",
      "dir": "lambda/routines-runner",
      "files": [
        "index.mjs",
        "package.json",
        "node_modules/"
      ],
      "npm": true
    },
    {
      "function": "agentcore-hub-session-reaper",
      "dir": "deploy/session-reaper",
      "paths": [
        "deploy/session-reaper/handler.py"
      ],
      "files": [
        "handler.py"
      ],
      "npm": false
    },
    {
      "function": "telegram-bug-intake",
      "dir": "deploy/telegram-bug-intake",
      "paths": [
        "deploy/telegram-bug-intake/index.mjs"
      ],
      "files": [
        "index.mjs"
      ],
      "npm": false
    }
  ],
  "s3": [
    {
      "src": "deploy/workflow-manager/toolkit/",
      "dst": "workflow-manager/toolkit/",
      "paths": [
        "deploy/workflow-manager/toolkit/"
      ],
      "args": [
        "--delete",
        "--exclude",
        "test_*.py",
        "--exclude",
        "*.pyc"
      ]
    },
    {
      "src": "deploy/workflow-manager/skills/",
      "dst": "workflow-manager/skills/",
      "paths": [
        "deploy/workflow-manager/skills/"
      ],
      "args": [
        "--delete",
        "--exclude",
        "*.pyc"
      ]
    },
    {
      "src": "deploy/routine-builder/toolkit/",
      "dst": "routine-builder/toolkit/",
      "paths": [
        "deploy/routine-builder/toolkit/"
      ],
      "args": [
        "--delete",
        "--exclude",
        "test_*.py",
        "--exclude",
        "*.pyc"
      ]
    },
    {
      "src": "src/config/pricing.json",
      "dst": "config/pricing.json",
      "paths": [
        "src/config/pricing.json"
      ]
    }
  ],
  "harnesses": [
    {
      "name": "agentcore_hub_workflow_manager",
      "script": "deploy/workflow-manager/setup-workflow-manager.mjs",
      "paths": [
        "deploy/workflow-manager/system-prompt.md",
        "deploy/workflow-manager/setup-workflow-manager.mjs",
        "deploy/workflow-manager/skills/"
      ]
    },
    {
      "name": "agentcore_hub_builder",
      "script": "deploy/setup-builder-agent.mjs",
      "paths": [
        "deploy/setup-builder-agent.mjs",
        "src/lib/models/harness-models.json",
        "src/lib/models/harness-models.mjs"
      ]
    },
    {
      "name": "agentcore_hub_routine_builder",
      "script": "deploy/routine-builder/setup-routine-builder.mjs",
      "paths": [
        "deploy/routine-builder/system-prompt.md",
        "deploy/routine-builder/setup-routine-builder.mjs"
      ]
    }
  ],
  "handoff": [
    "deploy/runtime-agent/build-and-push.sh",
    "deploy/runtime-agent/deploy.sh",
    "deploy/runtime-agent/deploy-fleet.sh",
    "deploy/runtime-agent/deploy-one.sh",
    "deploy/runtime-agent/deploy-one-robust.py",
    "deploy/runtime-agent/deploy-topology.sh",
    "deploy/runtime-agent/refresh-agents-json.sh",
    "deploy/runtime-agent/setup-fleet-memory.sh",
    "deploy/runtime-agent/setup-healthcheck.sh",
    "deploy/coding-agent-runtime/build-and-push.sh",
    "deploy/coding-agent-runtime/deploy.py",
    "deploy/coding-agent-runtime/cfn-vpc-efs.yaml",
    "deploy/coding-agent-runtime/setup-coding-efs.sh",
    "deploy/coding-agent-runtime/setup-coding-runtime-role.sh",
    "deploy/evaluations/",
    "deploy/continuous-improvement/",
    "deploy/connectors/",
    "deploy/apprunner/",
    "deploy/setup-lambda-role.sh",
    "deploy/setup-runtime-role.sh",
    "deploy/setup-tickets-lambda.mjs",
    "deploy/setup-pipeline-tools-lambda.mjs",
    "deploy/workflow-manager/deploy.sh",
    "deploy/routine-builder/deploy.sh",
    "deploy/session-reaper/deploy.sh",
    "lambda/cost-report/deploy.sh",
    "lambda/anomaly-watcher/deploy.sh",
    "lambda/routines-runner/deploy.sh",
    "lambda/workflow-output/deploy.sh",
    "lambda/orchestrator/deploy.sh",
    "lambda/orchestrator/template.yaml"
  ],
  "runtimes": [
    {
      "$comment": "Runtime-image CD (buildspec-runtime-images.yml): a change to a BAKED file rebuilds this runtime's arm64 image and image-swaps it via update-runtime-image.py (env/lifecycle/role/EFS preserved). Prompts (deploy/runtime-agent/prompts/) are NOT baked — they ship via Target 2's S3 sync and load at cold start, so they are not listed here.",
      "name": "agentcore_hub_agent",
      "ecrRepo": "runtime-agent",
      "context": "deploy/runtime-agent",
      "paths": [
        "deploy/runtime-agent/main.py",
        "deploy/runtime-agent/requirements.txt",
        "deploy/runtime-agent/install-skills.sh",
        "deploy/runtime-agent/Dockerfile"
      ]
    },
    {
      "name": "agentcore_hub_coding_runtime",
      "ecrRepo": "coding-agent-runtime",
      "context": "deploy/coding-agent-runtime",
      "paths": [
        "deploy/coding-agent-runtime/main.py",
        "deploy/coding-agent-runtime/requirements.txt",
        "deploy/coding-agent-runtime/otel-collector-config.yaml",
        "deploy/coding-agent-runtime/log.py",
        "deploy/coding-agent-runtime/run-codex.sh",
        "deploy/coding-agent-runtime/merge-codex-config.py",
        "deploy/coding-agent-runtime/shell-init.sh",
        "deploy/coding-agent-runtime/Dockerfile"
      ]
    }
  ],
  "handoff_exempt": [
    "deploy/runtime-agent/prompts/"
  ],
  "excluded": {
    "lambda/orchestrator": "Target 1 of buildspec-deploy.yml (one zip to orchestrator + agent-invoker + events-writer).",
    "lambda/builder-tools": "No deployed function \u2014 the builder harness uses code_interpreter; source kept for reference.",
    "deploy/pipeline": "The pipeline itself; buildspec/stack edits take effect on the next run or via deploy/pipeline/deploy.sh.",
    "deploy/ecs-express": "The app image is Target 3 (roll-by-digest); deploy.sh is the pre-pipeline manual path.",
    "deploy/local": "Gitignored scratch.",
    "deploy/config.sh": "Sourced by scripts; not a deploy surface.",
    "deploy/telegram-bug-intake/README.md": "Docs.",
    "deploy/runtime-agent/healthcheck-fixtures": "Fixtures for the fleet healthcheck (setup-healthcheck.sh); not baked, not deployed.",
    "deploy/runtime-agent/test-streaming": "Standalone OTEL span-test runtime; deployed out of band by its own deploy.sh.",
    "deploy/runtime-agent/verify-fleet-invoke.py": "Fleet smoke tool; run by hand.",
    "deploy/runtime-agent/verify-fleet.sh": "Fleet smoke tool; run by hand.",
    "deploy/runtime-agent/local-ab-test.py": "Local prompt A/B harness; dev-only.",
    "deploy/coding-agent-runtime/invoke.py": "Manual invoke/smoke tool; not deployed.",
    "deploy/lib": "Sourced shell helpers for the opt-in config-evals deploy guard (require_eval_gate, --force parsing). Library code consumed by the deploy scripts at run time — nothing to deploy."
  }
}
