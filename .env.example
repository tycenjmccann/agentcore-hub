# AWS Configuration
# Uses the default AWS credential chain: profile, env vars, or IAM role.
# Set AWS_REGION to the region where your AgentCore agents are deployed.
AWS_REGION=us-east-1

# Optional: specify a profile name if not using the default profile
# AWS_PROFILE=default

# Deployed App Runner URL (used by deploy scripts, CI, and tests)
# DEPLOYMENT_URL=https://xxxxx.us-east-1.awsapprunner.com
# PLAYWRIGHT_BASE_URL=https://xxxxx.us-east-1.awsapprunner.com

# GitHub owner (org or username for fleet repo and MCP integration)
# GITHUB_OWNER=your-github-username

# Repo URL pre-flight on workflow submit (verifies repoConfig URLs against GitHub;
# a definitive 404 is rejected with did-you-mean candidates). "off" disables it.
# REPO_CHECK_MODE=enforce

# Intake source validation: lenient (default) accepts unreachable-but-plausible sources and marks them unverified; strict rejects any non-verified source with 422
# SOURCE_VALIDATION_MODE=lenient

# Repo URL used by the in-app "Run Test Workflow" button and scripts/test-ticket-flow.sh
# Defaults to https://github.com/octocat/Hello-World if unset.
# Read at build time as NEXT_PUBLIC_TEST_REPO_URL by the frontend, and as TEST_REPO_URL by scripts.
# NEXT_PUBLIC_TEST_REPO_URL=https://github.com/your-org/your-repo
# TEST_REPO_URL=https://github.com/your-org/your-repo

# Harness Execution Role (optional — setup-builder-agent.mjs creates one automatically)
# Only set this if you want to use a pre-existing role instead.
# HARNESS_EXECUTION_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/agentcore-hub-harness-role

# Display brand — sets the name shown in the header, sidebar, and page titles.
# Defaults to "AgentCore Hub" if unset. Does NOT affect AWS resource names.
# NEXT_PUBLIC_BRAND_NAME=AgentCore Hub

# Builder Agent (required for Build page — set after running deploy/setup-builder-agent.mjs)
# The script creates the IAM role + deploys the harness. Just run:
#   node deploy/setup-builder-agent.mjs
#
# This is the HARNESS ID (not the runtime ID). The /build page builds a harness
# ARN from this: arn:aws:bedrock-agentcore:<region>:<account>:harness/<id>.
# AgentCore auto-provisions a runtime sibling named harness_agentcore_hub_builder-…
# when the harness is created — that's a different resource and not what /build uses.
# BUILDER_AGENT_ID=agentcore_hub_builder-xxxxxxxxxx

# Workflow Orchestration (required for Team Workflow feature)
# Single S3 bucket shared by App Runner, Lambdas, and runtime agents.
# Convention: agentcore-hub-artifacts-{ACCOUNT_ID}-{REGION}
# ARTIFACT_BUCKET=agentcore-hub-artifacts-ACCOUNT_ID-us-east-1

# GitHub MCP integration (required for workflow agents to push code/create PRs)
# Agents connect to GitHub's hosted MCP server via this token
# GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MCP Servers (JSON array — override GITHUB_PAT for custom MCP setups)
# MCP_SERVERS=[{"url":"https://api.githubcopilot.com/mcp/","headers":{"Authorization":"Bearer ghp_xxx"}}]

# Kiro CLI (Cloud Code) — bring-your-own-key only, no Bedrock fallback. Unlike
# Claude/Codex there is no per-user upload path; the coding runtime carries ONE
# shared access key. Without it, `kiro` sessions fail fast with "KIRO_API_KEY not
# set". Get a key from kiro.dev (ksk_...). KIRO_MODEL defaults to "auto" (kiro's
# server-side model routing); set a specific model id to pin.
# KIRO_API_KEY=ksk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# KIRO_MODEL=auto

# Model selection (optional — enables additional model providers)
# OPENAI_API_KEY_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:openai-api-key

# ─── Ticket Provider ────────────────────────────────────────────────────────
# "jira" = Jira Cloud is the ticket store. Jira webhooks trigger orchestration.
# "dynamodb" = DynamoDB is the ticket store. DynamoDB Streams trigger orchestration.
# Code default when unset = dynamodb; this file (and the Dockerfile) ship jira.
# NOTE: This is also a BUILD-TIME variable — it determines the frontend UI label
# (via next.config.mjs). If you change this after building, you must rebuild the app.
TICKET_PROVIDER=jira
WORKFLOWS_TABLE=agentcore-hub-workflows
EVENTS_TABLE=agentcore-hub-events

# ─── DynamoDB mode only ──────────────────────────────────────────────────────
# TICKETS_TABLE=agentcore-hub-tickets
# TICKET_TOOLS_LAMBDA=agentcore-hub-tickets

# ─── Jira mode only ─────────────────────────────────────────────────────────
# TICKET_TOOLS_LAMBDA=agentcore-hub-jira

# Webhook security (used by both modes)
# WEBHOOK_SECRET=your-secret-here

# Shared secret authorizing the reserved intakeChannel value "anomaly-detector" on /api/workflow/start; unset = reserved value rejected (403).
# ANOMALY_INTAKE_SECRET=your-random-secret

# ─── Agent Fleet Deployment ─────────────────────────────────────────────────
# These are used by deploy/runtime-agent/deploy-one.sh and deploy-fleet.sh
# AGENTCORE_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/YourAgentCoreExecutionRole
# GATEWAY_ARN=arn:aws:bedrock-agentcore:us-east-1:ACCOUNT_ID:gateway/your-gateway-id
# ARTIFACT_BUCKET=agentcore-hub-artifacts-ACCOUNT_ID-us-east-1

# Jira integration (required for real Jira mode)
# IMPORTANT: Your Jira project workflow MUST have a "Blocked" status with transitions
# from all other statuses. See README.md "Workflow setup" section for details.
# JIRA_SITE_URL=your-site.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=your-jira-api-token
# JIRA_PROJECT_KEY=TEAM

# ─── CI/CD pipeline module (optional) ────────────────────────────────────────
# See docs/cicd-pipeline-module-design.md + docs/pipeline-quickstart.md.
# Build-time flag — shows the /pipeline tab (NEXT_PUBLIC_* is baked at build).
# NEXT_PUBLIC_PIPELINE_ENABLED=1
# Fleet/orchestrator context — CI/QA/release-manager blueprints read pipeline
# results instead of shelling builds.
# PIPELINE_ENABLED=1
# WHICH repos the hub merges + deploys is the CD registry — config/cd-registry.json
# in the artifact bucket (scripts/cd-registry.sh, or Workflow tab → CD registry…),
# not an env var. Unregistered repos are a HANDOFF: the run ends with an open PR.
# Pipeline Mode is emitted only for a registered repo whose entry names a pipeline.
# CD_REGISTRY_TTL_MS=60000
# Name of the Pipeline___* tools Lambda the fleet runtime invokes.
# PIPELINE_TOOLS_LAMBDA=agentcore-hub-pipeline-tools
# IaC flag (0/1, default 0), read ONLY by deploy/setup-pipeline-tools-lambda.mjs
# (not by this app): grants that Lambda codebuild:StartBuild on CI_PROJECT so
# Pipeline___start_ci_build can actually run — the fallback for when the
# PR-check webhook (PIPELINE_CI_WEBHOOK, below) cannot be installed. CI_PROJECT
# must be a PR-check project with no deploy permissions; the setup script
# refuses to grant this on the build/deploy project or the pipeline itself.
# PIPELINE_CI_START_BUILD=0
# NOTE: DEPLOY_PIPELINE_NAME (deploy-gate Telegram bridge) lives on the
# telegram-bug-intake Lambda, and PIPELINE_CI_WEBHOOK (CodeBuild PR-check
# webhook, default OFF) is a CDK-deploy-time flag — neither is read by the app.

# ─── Orchestrator resilience flags ───────────────────────────────────────────
# Ship merge-verify completion gate (default ON): a ship-phase run cannot
# finalize while its feature branch is provably unmerged. Set to opt OUT:
# SHIP_MERGE_VERIFY=off
# Merge-on-green (default off): off | shadow (observe-only, would-merge metrics,
# zero writes) | enforce. When enforce, the orchestrator merges a human-approved
# (Merge-Approval gate done), clean+green (mergeable_state:"clean") final PR
# itself — with the exact head SHA — instead of leaving the run open on
# workflow.cd_unmerged. Decouples merge from deploy. Instant rollback = set off.
# MERGE_ON_GREEN=enforce
# Ship-head stability gate (default off): off | shadow (observe-only — measures
# the would-defer rate via ShipHeadWouldDefer, always dispatches, zero writes) |
# enforce. Keeps the release_manager off a MOVING branch head: at ship-ticket
# (re)dispatch it dispatches only when the PR head has been quiet >= ~3min AND CI
# is green on THAT exact head; otherwise it defers (re-queues) instead of invoking
# the RM on a head about to move again. A real CI red on the head passes straight
# through to the CI-fix path (never masked); a perpetually-moving head fails open
# after maxDeferrals. Deferred tickets are re-driven on the reconcile-sweep tick,
# so this does NOT depend on RECONCILE_SWEEP_MODE. Instant rollback = set off.
# SHIP_HEAD_STABILITY=enforce
# Ship-dispatch prerequisite gate (default off): off | shadow (observe-only —
# measures the would-gate rate via ShipDispatchWouldGate, always dispatches,
# zero writes) | enforce. Keeps the release_manager from being dispatched while
# its prerequisite dev/QA/CI sibling tickets are still open — the deterministic
# backstop for a missing/incomplete blockedBy graph (a forgotten dependency
# edge, a nudge/reconcile that re-drove the ship ticket to Ready early, or a fix
# ticket that re-opened a prerequisite). When enforce, it writes the missing
# blockedBy edge (Jira "Blocks" link + Blocked / DynamoDB blockedBy+status) so
# the existing unblock cascade re-wakes ship when the prerequisite completes.
# Unclassifiable prerequisites (e.g. human-review gates) and phases with no
# tickets never gate — the gate can never wedge ship. Instant rollback = set off.
# SHIP_DISPATCH_GATE=enforce
# Rework-loop cap (default off): off | shadow (observe-only — records a
# per-(workflow,phase) rework ledger + ReworkLoop* metrics + a WOULD-cap log,
# zero events) | enforce. The lineage backstop the per-gate review-cap can't
# give: it counts fix tickets (qa_fix/review_fix/codex_fix reaching Done) PER
# PHASE, keyed `${workflowId}:${phase}`, so a loop that keeps filing FRESH fix
# ticket ids (a bug-fix reopen, a dedupe miss) still accumulates instead of
# resetting the count to 1 each time. At the cap (default 4 rounds) enforce
# publishes `rework.cap_reached` (the Workflow Manager WATCH + system-SI loop
# consume it) and best-effort parks the run's open release-manager escalation
# gate — it never creates a ticket, refuses fix creation, or blocks the cascade
# (those are Phase-2). UNLIKE the ship gates, a PRESENT-but-garbage value fails
# safe to SHADOW (an unbounded loop is the dangerous failure, so unknown still
# measures); only unset/"off" is off. Instant rollback = set off.
# REWORK_LOOP_CAP=enforce
# Live-evidence re-verification (default off): off | shadow | enforce. A fix
# ticket can declare `evidence_source=live` — "I ran the system and watched it
# fail" — and then be closed with a completion record that carries nothing but
# prose. Nobody re-runs the live check at the new head, so the run ships on a
# claim: the reviewer's original observation plus a dev's word. When on, a live
# fix reaching Done (1) gets ONE `Re-verify (QA): <fix> @ <sha7>` ticket, blocked
# on the fix and BLOCKING the run's open ship tickets, carrying the same contract
# so the re-run is checkable, and (2) is marked `verification: unverified` when
# its completion record carries no live artifact (`evidence_kind=live` or a
# `qa-evidence/` key) — which the release manager then sees as an
# `## Unverified Fixes` block it must re-run before any PASS. Idempotent per
# (fix, head sha): re-Done'ing a fix files nothing new; a fix re-Done'd at a NEW
# head does. off = byte-identical (module never constructed, no extra read in
# either done twin, no context block). shadow publishes `fix.reverify_planned`
# only — zero ticket/workflow writes. NOTE the direction flips here: a
# PRESENT-but-garbage value coalesces to OFF (like the ship gates, unlike
# REWORK_LOOP_CAP/FIX_TICKET_CONTRACT) because enforce creates REAL tickets that
# dispatch a real agent. Instant rollback = set off.
# LIVE_REVERIFY=shadow
# CI reachability pre-flight (default off): off | shadow | enforce. On a
# pipeline-mode run the CI agent is told to read the authoritative CodeBuild
# PR-check for the head SHA — but when the CI project has NO PR webhook AND the
# pipeline-tools Lambda cannot StartBuild, no build can EVER exist for any head,
# so the only honest CI verdict is a permanent BLOCKED. Today that fact lives
# only inside the CI agent's completion record, which the human merge approver
# does not read, so the run reaches the gate looking green. shadow probes once
# per workflow (BatchGetProjects on the CI project for a PR-triggering webhook,
# Pipeline___capabilities for start_ci_build, and — with a PAT — the repo's
# GitHub hooks as corroboration) and states the verdict to EVERY persona as a
# `## CI Certification` block; zero ticket writes. enforce additionally labels
# the run's epic `ci:uncertifiable` (once per workflow) and prefixes the human
# merge-gate's review package with the warning. `unknown` — any probe that could
# not answer, including a missing IAM grant — NEVER acts: a broken probe must not
# manufacture a warning about the pipeline. off = byte-identical (no probe, no
# CodeBuild/IAM SDK load — both are dynamic imports — no context block). STRICT
# allow-list: a PRESENT-but-garbage value coalesces to OFF, not shadow, because
# enforce writes to a real ticket. Needs the CiCheckRead grant from
# deploy/setup-lambda-role.sh (codebuild:BatchGetProjects on the CI project ONLY
# — that call returns webhook.url/secret + the project's env vars, so it is never
# scoped to project/*). Instant rollback = set off.
# CI_CHECK_MODE=shadow
# Override the 6h cache for a SETTLED verdict (an `unknown` is always re-probed
# after 30min). Only meaningful with CI_CHECK_MODE set.
# CI_CHECK_TTL_MS=21600000
# 1 = read the pipeline-tools ROLE's real policy for codebuild:StartBuild via
# iam:SimulatePrincipalPolicy instead of trusting the Lambda's self-reported
# capability, and prefer that answer. Requires PIPELINE_TOOLS_ROLE_ARN plus the
# optional CiCheckSimulate grant (created by deploy/setup-lambda-role.sh only
# when PIPELINE_TOOLS_ROLE_ARN is set, scoped to that one role).
# CI_CHECK_USE_IAM_SIMULATE=1
# PIPELINE_TOOLS_ROLE_ARN=arn:aws:iam::<account>:role/<pipeline-tools-role>
# The CodeBuild PR-check project the probe reads when the repo's CD registry
# entry carries no `ciProject`. This is a CodeBuild PROJECT, not a CodePipeline.
# CI_PROJECT_NAME=agentcore-hub-ci
# Pre-CI default-branch sync (default off): off | shadow | enforce. Three dev
# agents push to ONE shared feature branch and the CI agent then certifies its
# head SHA — but the repo's default branch has moved since they branched. A green
# build therefore says "this branch is green", NOT "this branch is green on top of
# what is on main now", which is exactly how the human merge approver reads it.
# Every conflict, and every semantic clash with a sibling team's merge, surfaces
# AFTER the approval — on the merge itself, where no agent is watching. Merging
# the default branch in FIRST makes the SHA the CI agent certifies the SHA that
# will actually land. shadow = one `compare` read per CI dispatch plus a
# `workflow.sync_dry_run` event; it tells you how far BEHIND the branch is and
# whether a sync WOULD happen, and that is all — it CANNOT tell you whether the
# merge would CONFLICT, because only attempting the merge can, so `conflictKnown`
# is always false. Do not read a quiet shadow rollout as "no conflicts here".
# enforce = POST the merge (default branch INTO the feature branch; the direction
# is pinned in code and this can never write to the default branch) immediately
# before the CI agent is dispatched. 201 = synced, 204 = already up to date, 409 =
# conflict: a `Fix (sync-main)` sync_fix ticket is filed against the dev who most
# recently finished on the run, the CI ticket is blocked on it, and the CI ticket's
# claim is released so the normal cascade re-dispatches CI once the fix closes.
# Requires GITHUB_PAT — with no PAT this is a silent no-op. Fails OPEN everywhere
# else: no repo, an unreadable default branch, 404/422/5xx, a network error, or a
# conflict it could not ticket all leave CI to run against the un-synced head
# (the pre-4122 behaviour), because a sync we could not do must never wedge CI.
# Idempotent: a redelivery against the same default-branch head does nothing.
# Skips `-advisory` branches and any run whose feature branch IS the default
# branch. off = byte-identical (no GitHub call, no event, no write). STRICT
# allow-list: a PRESENT-but-garbage value coalesces to OFF, not shadow, because
# enforce PUSHES A COMMIT to a shared branch. Instant rollback = set off (already
# merged commits stay; nothing to unwind).
# SYNC_MAIN_BEFORE_CI=shadow
# Advisory-ticket routing (default off): off | enforce. Both reviewers file
# out-of-scope-but-worth-doing work as an ADVISORY ticket — `labels: "advisory"`,
# `blocked_by: ""`, no `spawned_by_kind` — and the blueprints describe it as
# backlog for the owning agent that this run does NOT wait on. Today the label is
# inert to the orchestrator, so the prose is a promise the code does not keep: the
# completion guard still waits for the ticket to close (and, if it ever carried a
# spawned_by_kind, the open-fix gate would hold the run open on it), and the dev
# who picks it up is told to branch off the run's SHARED integration branch — so
# the scope the humans explicitly declined merges into the integration branch and
# ships inside the unified PR next to the approved work. enforce makes the label
# mean what it says: (1) advisory tickets are filtered out of the completion,
# deliverable-evidence, open-fix and ship-verdict gates; (2) their `## Branch`
# block reads `feature_branch: feature/<id>-advisory`, `base_branch: <default
# branch>` and tells the agent to open its PR against the default branch, so the
# work is still delivered — just not into this run; (3) a `-advisory` branch is
# never adopted as a run's shared integration branch (the same name sync-main
# already refuses to sync). There is deliberately NO shadow mode here, unlike the
# flags above: routing is USER-VISIBLE — the only thing to "observe" is the branch
# name written into an agent's prompt, so a shadow would either lie to the agent
# (log one branch, tell it another) or do literally nothing. Roll out only AFTER
# create_ticket's `labels` param is deployed on both ticket Lambdas and the runtime
# image; until tickets actually carry labels, enforce reads every ticket as
# non-advisory — i.e. exactly today's behaviour. off = byte-identical. STRICT
# allow-list: a PRESENT-but-garbage value coalesces to OFF, because enforce changes
# what the run waits on. Instant rollback = set off.
# ADVISORY_ROUTING=enforce
# Events-table double-write collapse (default off): off | enforce. Every
# orchestrator/agent-invoker event is stored TWICE in the events table today —
# once by the publisher's own Put, once by the events-writer fan-out of the SAME
# EventBridge event — under two different eventIds, so anything that counts rows
# double-counts. When enforce, all three writers derive the eventId from the
# event's CONTENT (`<ms>-<sha1(type|timestamp|ticketId|agentId) first 8 hex>`,
# the same content key the consumers already dedupe by), so the fan-out Put
# lands on the same (workflowId, eventId) and OVERWRITES the direct copy: one
# row per event. Benign — the table has no GSI, neither writer stamps `ttl`, and
# the two items differ only by the `source` attribute. agent.streaming keeps
# random ids (its chunks share a content key; collapsing them would drop
# liveness heartbeats). Unlike the rework cap, a PRESENT-but-garbage value (and
# "shadow", which this flag does not implement) coalesces to OFF — a typo must
# never change what lands in the table. Set on ALL THREE writers or none:
# deploy.sh forwards it to orchestrator+agent-invoker+events-writer together,
# because one writer left in off keeps writing its own second row.
# pull_dossier/compute_metrics dedupe by content regardless of the flag, so
# their numbers are correct either way — this removes the duplicate rows those
# passes exist to paper over. Instant rollback = set off.
# EVENT_DEDUPE_MODE=enforce
# Human review-gate state machine (default off): off | shadow | enforce. The
# reject path reads a reviewer's "Request changes" off ONE ambiguous signal — the
# gate ticket reaching `blocked` — which ALSO fires for the gate's creation-time
# dependency block (TEAM-4044 fixed that case by pinning the previous status),
# for the same rejection arriving twice (a webhook redelivery, or the Jira and
# DDB-stream twins both handling it), and for a gate no human was ever asked
# about. When on, the orchestrator records `requested` on the workflow row when
# it parks a gate for a human and admits a rejection only for a gate actually
# sitting in `requested`; approvals and rejections close the cycle. off = the
# guard returns "admitted" before reading anything, so ZERO extra DynamoDB I/O
# and byte-identical behavior. shadow = classify, RECORD the state, and publish
# `gate.reject_ignored{wouldDrop:true}` for what enforce WOULD have dropped, but
# still run every rejection (so it is NOT byte-identical — it writes, which is
# the point: the ledger is populated and its CAS exercised before anyone
# enforces). enforce = actually drop the unrequested/duplicate ones. Runs with no
# recorded state (parked before this shipped) fall back to "was a review_needed
# notification ever created for this gate", so a live gate keeps working across
# the rollout. A PRESENT-but-garbage value coalesces to OFF — unlike the rework
# cap, the dangerous failure here is DROPPING a human's Request-changes, so an
# unrecognized mode gets neither enforce nor shadow. Orchestrator only. Instant
# rollback = set off.
# GATE_STATE_GUARD=shadow
# Dead-session sweep mode: off | shadow (default — observe-only, zero writes) |
# enforce (retries/escalates dead agent sessions).
# DEAD_SESSION_DETECTOR_MODE=shadow
# Dead-session ESCALATION tree (TEAM-4120 FR-3): what happens when the dead-session
# retry budget is spent. Today: an evidence-free "needs a human" notification, and
# the ticket is held in `error` until somebody reconstructs the run by hand.
# off (default) | shadow | enforce.
#   page       — always (shadow AND enforce): ONE notification carrying the agent's
#                last streamed words (secret-redacted), the tickets it spawned inside
#                the claim window, whether a completion record + PR exist, and the
#                disposition. Reads only.
#   synthesize — enforce only. A completion record that bears evidence AND was written
#                during THIS claim → the ticket is transitioned Done and the normal
#                done handlers harvest it. It NEVER marks a ticket Done on a stale or
#                evidence-less record. Spawned children but no record → the ticket is
#                blocked on those children and its retry budget is handed back, so the
#                ordinary unblock cascade resumes it with no human in the loop. That
#                automatic reset is capped at ONCE per ticket; the second death parks.
#   park        — enforce only, when there is no evidence (or an agent error was
#                reported): one human gate is created, the ticket is blocked on it, and
#                the gate is parked. Approving the gate resets the budget and the
#                gate's own done cascade resumes the ticket.
# off = byte-identical (the module is never constructed). A PRESENT-but-garbage value
# coalesces to SHADOW (like REWORK_LOOP_CAP, opposite of GATE_STATE_GUARD): the
# dangerous failure here is doing nothing about a dead run. Orchestrator only.
# Instant rollback = set off.
# DEAD_SESSION_ESCALATION_MODE=shadow
# Extended cascade states: off (default) | shadow (observe-only) | enforce
# (legacy on|true|1 also mean enforce). Unrecognized values fail safe to off.
# CASCADE_EXTENDED_STATES=enforce
# Missed-unblock reconciliation sweep: off (default, dark — zero DDB reads) |
# shadow (observe-only) | enforce (re-drives stalled dependents).
# RECONCILE_SWEEP_MODE=shadow
# Completion evidence gate (default ON) — read by /api/workflow/[id]/complete.
# Set off|false|0 to fall back to trusting the completion call without evidence:
# COMPLETION_EVIDENCE_REQUIRED=off
# R1 FIFO command queue — serializes webhook-driven orchestrator commands.
# Printed by scripts/create-command-queue.sh; unset = legacy direct Lambda invoke.
# WORKFLOW_COMMAND_QUEUE_URL=

# ─── Ticket Lambdas ─────────────────────────────────────────────────────────
# Fix-ticket contract (default off): off | shadow | enforce. Read by BOTH ticket
# Lambdas — deploy/setup-tickets-lambda.mjs forwards it to whichever one
# TICKET_PROVIDER selects, so one value covers Jira and DynamoDB mode alike.
# Today an agent can file a fix ticket that says only "fix the login bug": no
# statement of what must hold afterwards, no evidence that the finding is real,
# no cited line. The dev then guesses, the re-review has nothing objective to
# check, and the loop goes around again. When on, a ticket carrying
# `spawned_by.kind` must also carry a contract — `invariant` (one sentence: the
# property that must hold after the fix), `evidence_source` (static|unit|live),
# `evidence_repro` (the command or artifact key, required for unit|live),
# `cited_location` (path:line, required for review/qa/codex/ship fixes) and
# `spawned_by_origin_id`. off = byte-identical to before: the validator is never
# called and nothing new is stored or labelled. shadow = validate, ACCEPT
# anyway, persist the partial contract with a `warnings` list, return a WARNING:
# line to the agent, stamp `contract:incomplete`, and (orchestrator) publish
# `ticket.contract_warning` — so the real rate of under-specified fix tickets is
# measurable before anyone enforces. enforce = reject the create call with the
# missing/invalid field list and mint NO ticket. A PRESENT-but-garbage value
# coalesces to SHADOW (like REWORK_LOOP_CAP, opposite of GATE_STATE_GUARD): the
# dangerous failure here is REFUSING to file fix tickets, which would strand a
# review loop, so an unrecognized mode observes instead of blocking. Plain
# (non-fix) tickets are unaffected in every mode. Instant rollback = set off.
# FIX_TICKET_CONTRACT=shadow

# ─── Workflow Manager ───────────────────────────────────────────────────────
# Business-hours window for the WM's human-wait analysis, read by
# deploy/workflow-manager/toolkit/compute_metrics.py (business_window) and used
# for ONE thing: was the human ASKED inside their working hours. A merge approval
# requested 11:20 UTC on a Saturday that waited 7 hours is not the same finding
# as one that sat untouched through a Tuesday afternoon, and "the humans are
# slow" is the wrong conclusion when the truth is "we asked at 4am on a
# weekend". Per-review `outsideHours` + the run's `humanReviewsOutsideHours`.
# Half-open [start, end) LOCAL hours, 24h clock, Sat/Sun always outside.
# Unset or unparseable → the defaults below, plus a `missingSignals` note (a
# typo must not silently mark a whole run "outside hours").
# WM_BUSINESS_HOURS=08-18
# IANA zone the hours above are local to. UTC when unset.
# WM_BUSINESS_TZ=America/Los_Angeles
