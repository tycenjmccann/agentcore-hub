    {
      "name": "projection-prev-keys",
      "note": "The carried keys come from the LIVE pricing document, byte-for-byte, so an operator's cache-multiplier tuning is not reverted by a catalog edit. `models` is always fully regenerated - the previous models map is ignored entirely.",
      "registry": "seed",
      "input": {
        "kind": "projection",
        "previousPricing": {
          "models": { "some.stale.model": { "input": 999, "output": 999 } },
          "default": { "input": 7.25, "output": 36.25 },
          "cachedInputDiscount": 0.08,
          "cacheWriteMultiplier": { "5m": 1.3, "1h": 2.1, "default": 1.3, "_basis": "operator-tuned" },
          "kiro": { "usdPerCredit": 0.04, "_basis": "overage rate" },
          "agentcore": { "runtimeGbHourUsd": 0.01, "runtimeVcpuHourUsd": 0.09, "_basis": "operator-tuned" }
        }
      },
      "expected": {
        "carriedEqualsPrevious": ["default", "cachedInputDiscount", "cacheWriteMultiplier", "kiro", "agentcore"],
        "modelsExclude": ["some.stale.model"],
        "spot": {
          "us.anthropic.claude-fable-5-1": { "input": 11, "output": 55, "cacheReadInput": 0.275 }
        }
      }
    },
