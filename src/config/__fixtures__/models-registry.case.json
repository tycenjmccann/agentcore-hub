    {
      "name": "dated-duplicate-dropped",
      "note": "Discovery returns both the stable alias and the dated snapshot of the same model; the dated row is noise unless something targets it.",
      "registry": "seed",
      "patch": {
        "addRows": [
          {
            "modelId": "us.anthropic.claude-sonnet-5-20260101-v1:0",
            "label": "Claude Sonnet 5 (dated)",
            "vendor": "anthropic",
            "family": "sonnet",
            "endpoint": "bedrock-runtime",
            "region": "us-east-1",
            "api": "converse",
            "contextWindow": 200000,
            "aliases": [],
            "price": { "input": 2.2, "output": 11, "source": "published", "asOf": "2026-09-23" },
            "status": "active"
          }
        ]
      },
      "input": { "kind": "parse" },
      "expected": {
        "catalogIdsInclude": ["us.anthropic.claude-sonnet-5"],
        "catalogIdsExclude": ["us.anthropic.claude-sonnet-5-20260101-v1:0"],
        "warnings": [{ "modelId": "us.anthropic.claude-sonnet-5-20260101-v1:0", "reason": "dated_duplicate" }]
      }
    },
