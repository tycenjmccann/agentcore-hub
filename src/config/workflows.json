      "type": "feature",
      "name": "Operator",
      "displayName": "Operator",
      "description": "Single-agent express flow: one operator persona shapes the work, drives a Claude Code worker (plan first, then execute with worktree fan-out), gets an independent cross-model review, opens the PR, watches CI and briefs the human. A human approves the merge, then the same operator merges and deploys. For bug fixes, features and laptop /plan handoffs.",
      "icon": "Zap",
      "intakeAgentId": "agentcore_hub_operator",
      "requiresRepo": true,
      "featureBranchPhase": null,
