          "type": "agent",
          "agentPhase": "design"
        },
        {
          "id": "development",
          "name": "Development",
          "type": "agent",
          "agentPhase": "development"
        },
        {
          "id": "qa",
          "name": "QA & Ship",
          "type": "agent",
          "agentPhase": "verification",
          "extraAgentPhases": [
            "review",
            "ship"
          ]
        }
