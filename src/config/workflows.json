{
  "defaultWorkflowDefId": "software-delivery",
  "deliverableFamilies": {
    "brief": {
      "title": "Decision brief",
      "reader": "a human or agent who must approve or reject",
      "template": "template-brief",
      "sections": [
        "Decision",
        "Why it is ready",
        "What needs your eye",
        "After approval"
      ]
    },
    "assessment": {
      "title": "Assessment",
      "reader": "whoever acts on the findings",
      "template": "template-assessment",
      "sections": [
        "Verdict",
        "Findings",
        "Not covered",
        "Next actions"
      ]
    },
    "spec": {
      "title": "Spec / plan / design",
      "reader": "whoever builds from it",
      "template": "template-spec",
      "sections": [
        "Outcome",
        "Scope",
        "Approach",
        "Acceptance"
      ]
    },
    "record": {
      "title": "Record",
      "reader": "whoever tracks progress or audits later",
      "template": "template-record",
      "sections": [
        "Status",
        "Timeline",
        "Open items"
      ]
    },
    "external": {
      "title": "External content",
      "reader": "the end audience (customer, counterparty, public)",
      "template": "template-external",
      "sections": [
        "Brief",
        "Content",
        "Notes for review"
      ]
    }
  },
  "workflows": [
    {
      "id": "software-delivery",
      "type": "feature",
      "name": "Software Delivery",
      "displayName": "SDLC",
      "description": "Autonomous feature/bug pipeline: requirements analysis, parallel design, development, CI certification, QA verification, and a release manager that reviews the final PR \u2014 a human approves the merge, then it merges and deploys per the repo's DEPLOY.md.",
      "icon": "GitPullRequest",
      "intakeAgentId": "agentcore_hub_requirements_analyst",
      "requiresRepo": true,
      "featureBranchPhase": "development",
      "createsPullRequest": true,
      "completionRequiresAgentPhases": [
        "development",
        "verification",
        "review",
        "ship"
      ],
      "reviewGates": [
        {
          "afterPhase": "requirements",
          "name": "Spec Approval",
          "blocking": true,
          "condition": "flagged",
          "onReject": "rework",
          "reviewerRole": "Product Owner",
          "assignee": "human:product-owner"
        },
        {
          "afterPhase": "design",
          "name": "Plan Approval",
          "blocking": true,
          "condition": "flagged",
          "onReject": "rework",
          "reviewerRole": "Designer",
          "assignee": "human:engineer"
        },
        {
          "afterPhase": "ship",
          "name": "Merge Approval",
          "blocking": true,
          "condition": "always",
          "onReject": "rework",
          "reviewerRole": "Code Owner",
          "assignee": "human:engineer",
          "maxRounds": 3,
          "regressionCountsDouble": true,
          "onCapReached": "escalate"
        }
      ],
      "writingStandard": true,
      "deliverables": [
        {
          "key": "intent.md",
          "title": "Intent (verbatim request)",
          "phase": "intake",
          "family": "external",
          "author": "hub",
          "reader": "requirements analyst, Product Owner",
          "required": true,
          "template": null,
          "note": "the request as submitted; never rewritten"
        },
        {
          "key": "requirements.md",
          "title": "Requirements",
          "phase": "requirements",
          "family": "spec",
          "author": "agentcore_hub_requirements_analyst",
          "reader": "designers, dev agents, Product Owner (Spec Approval)",
          "required": true,
          "gate": "Spec Approval"
        },
        {
          "key": "review-package-requirements.json",
          "title": "Spec Approval package",
          "phase": "requirements",
          "family": "brief",
          "author": "agentcore_hub_requirements_analyst",
          "reader": "Spec Approval reviewer (Telegram ping)",
          "required": false,
          "template": "review-package",
          "gate": "Spec Approval",
          "note": "only when the Spec Approval gate is flagged"
        },
        {
          "key": "spec.md",
