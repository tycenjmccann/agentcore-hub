      normalizeVerdictMode               "ENFORCE "/"Shadow" handled: YES
      normalizeVerifiedHeadMode          "ENFORCE "/"Shadow" handled: YES
      normalizeSweepCadenceMode          "ENFORCE "/"Shadow" handled: YES
      normalizeTicketPlanValidatorMode   "ENFORCE "/"Shadow" handled: YES
      normalizeDecisionLedgerMode        "ENFORCE "/"Shadow" handled: YES

