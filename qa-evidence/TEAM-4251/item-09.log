  this gate's own tombstone (type:'skipped')   skip=null
  a DELETE-route tombstone (deleted:true)      skip=null
  another def                                  skip=null
  another repo                                 skip=null
  no usable timestamp                          skip=null
  a FUTURE timestamp                           skip=null

