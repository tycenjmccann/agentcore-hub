+export async function archiveWorkflow(workflowId: string): Promise<ArchiveResult> {
+  const workflow = await workflowStore.get(workflowId);
+  const done = workflow.tickets.filter((t) => t.status === "done");
+  try {
+    await artifactStore.moveToArchive(workflowId);
+  } catch (err) {
+    // Artifact move is best-effort; archive metadata is what users see.
+    console.log("archive: artifact move skipped", workflowId);
+  }
+  await workflowStore.markArchived(workflowId, done.length);
+  return { archived: true, archivedTicketCount: done.length };
+}
+
+export async function archiveAll(workflowIds: string[]): Promise<number> {
+  let count = 0;
+  for (const id of workflowIds) {
+    const result = await archiveWorkflow(id);
+    if (result.archived) count += 1;
+  }
+  return count;
+}
