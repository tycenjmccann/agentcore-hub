+import { describe, it, expect } from "vitest";
+import { writeAndList } from "./list-with-latest";
+
+describe("writeAndList", () => {
+  it("returns the new key in the listing", async () => {
+    // in-memory fake client: put() is immediately visible to listKeys()
+    const result = await writeAndList("shared/", "notes.md", "hello");
+    expect(result.latestKey).toBe("shared/notes.md");
+    expect(result.keys).toContain("shared/notes.md");
+  });
+});
