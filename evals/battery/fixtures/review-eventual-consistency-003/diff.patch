+import { artifactClient } from "./client";
+
+export interface ArtifactListing {
+  keys: string[];
+  latestKey: string;
+}
+
+// Writes the new artifact, then returns the refreshed listing for the panel.
+// The UI highlights `latestKey`, so it must be present in `keys`.
+export async function writeAndList(
+  prefix: string,
+  name: string,
+  content: string
+): Promise<ArtifactListing> {
+  const key = `${prefix}${name}`;
+  await artifactClient.putObject(key, content);
+  const keys = await artifactClient.listKeys(prefix);
+  const latestKey = keys.find((k) => k === key)!;
+  return { keys, latestKey };
+}
