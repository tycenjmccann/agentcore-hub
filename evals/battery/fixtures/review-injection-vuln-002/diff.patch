+import { NextRequest, NextResponse } from "next/server";
+import { execSync } from "node:child_process";
+import { readFileSync } from "node:fs";
+
+// Exports the tickets report in the requested format using the report CLI.
+// Supported formats: csv, pdf, html.
+export async function GET(req: NextRequest) {
+  const format = req.nextUrl.searchParams.get("format") || "csv";
+  const name = req.nextUrl.searchParams.get("name") || "tickets-report";
+  const outPath = `/tmp/exports/${name}.${format}`;
+
+  // The report CLI handles all formats; shell out and stream the file back.
+  execSync(`report-cli export --format ${format} --out ${outPath}`, {
+    timeout: 30000,
+  });
+
+  const body = readFileSync(outPath);
+  return new NextResponse(body, {
+    headers: {
+      "Content-Type": contentTypeFor(format),
+      "Content-Disposition": `attachment; filename="${name}.${format}"`,
+    },
+  });
+}
+
+function contentTypeFor(format: string): string {
+  switch (format) {
+    case "pdf":
+      return "application/pdf";
+    case "html":
+      return "text/html";
+    default:
+      return "text/csv";
+  }
+}
